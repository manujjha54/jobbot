# Copy this file to .env for local testing (or set these as real environment
# variables in your hosting platform's dashboard - Render, Railway, Fly.io
# all have a place for this). NEVER commit a real .env file with actual
# secrets to git.

# Flask session signing - use a long random string in production
SECRET_KEY=change-this-to-something-random-and-long

# Whoever signs up with this email automatically becomes an admin
ADMIN_EMAIL=you@example.com

# Encrypts stored Gmail app passwords. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this the same across restarts/deploys, or previously-stored passwords
# become unreadable (not a security problem, just an annoyance - affected
# users would need to re-enter their Gmail app password).
ENCRYPTION_KEY=

# Your OWN Adzuna key (free signup: https://developer.adzuna.com/). This is
# used server-side only, shared across all users via the job pool refresh -
# it is never sent to any browser. Leave blank to run on RemoteOK only.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us

# Where the sqlite database file lives. On most hosting platforms this
# needs to point at a persistent/mounted volume, or point DATABASE_PATH at
# a managed Postgres instead for real production use (see README).
DATABASE_PATH=jobbot.db

PORT=5000
